{
  "name": "dsh-mcp-toggle",
  "version": "1.0.0",
  "description": "Enable/disable MCP servers directly from DSH Settings: a 'MCP Servers' page that stops/starts @deepseek-ai/dsh-mcp-client connections live and persists the change across restarts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zenjibad/dsh-mcp-toggle.git"
  },
  "homepage": "https://github.com/Zenjibad/dsh-mcp-toggle#readme",
  "bugs": {
    "url": "https://github.com/Zenjibad/dsh-mcp-toggle/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "src",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "llms.txt",
    "llms-full.txt",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "mcp",
    "mcp-client",
    "settings",
    "enable",
    "disable",
    "toggle"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.4.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node tests/dsh-mcp-toggle.test.mjs && node tests/dsh-mcp-toggle-locked.test.mjs",
    "check": "pnpm typecheck && pnpm test"
  }
}
